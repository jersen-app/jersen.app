# Jersen Docker Ignore
# Prevents unnecessary files from being copied to Docker image

# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
out
build
dist

# Development files
.env*.local
.env.development
.env.test

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# Documentation
docs/
*.md
!README.md

# Testing
coverage/
.nyc_output/
jest.config.*
*.test.*
*.spec.*
__tests__/

# Misc
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Docker
Dockerfile*
docker-compose*
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.circleci/

# Vercel
.vercel
